# Public, safe to expose in web and mobile bundles. Use the publishable/anon key,
# never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only. Configure in the server deployment environment; do not copy into
# an EXPO_PUBLIC_ or NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=replace-server-side-only
